{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "yet-another-todo-app-common-components",
  "prefix": "yata",
  "projectType": "library",
  "sourceRoot": "libs/yet-another-todo-app-common-components/src",
  "tags": [],
  "targets": {
    "build": {
      "configurations": {
        "development": {
          "tsConfig": "libs/yet-another-todo-app-common-components/tsconfig.lib.json"
        },
        "production": {
          "tsConfig": "libs/yet-another-todo-app-common-components/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production",
      "executor": "@nx/angular:ng-packagr-lite",
      "options": {
        "project": "libs/yet-another-todo-app-common-components/ng-package.json"
      },
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"]
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "libs/yet-another-todo-app-common-components/jest.config.ts"
      },
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
