{
  "name": "yet-another-todo-app-theme",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/yet-another-todo-app-theme/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "prebuild": {
  "executor": "nx:run-commands",
  "options": {
    "command": "tsx scripts/generate-theme.ts",
    "cwd": "libs/yet-another-todo-app-theme"
  }
},
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "dependsOn": ["prebuild"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/yet-another-todo-app-theme/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/yet-another-todo-app-theme/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/yet-another-todo-app-theme/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["prebuild"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/yet-another-todo-app-theme/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
